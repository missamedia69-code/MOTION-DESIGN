 "lines": [
  {
   "text": "Tu paies chaque mois... pour toujours la même chose ?",
   "s": 0.02,
   "e": 2.78
  },
  {
   "text": "On mérite mieux !",
   "s": 2.953,
   "e": 3.814
  },
  {
   "text": "Voici MISSA TV 360 : tout ton divertissement dans une seule appli.",
   "s": 3.971,
   "e": 8.464
  },
  {
   "text": "Des milliers de films, séries, mangas, des centaines de chaînes en direct, du sport, la radio... et même des jeux !",
   "s": 8.48,
   "e": 13.27
  },
  {
   "text": "Un film en tête ? Tape son nom dans la recherche... il est là !",
   "s": 13.757,
   "e": 15.97
  },
  {
   "text": "Avec ta box WiFi, même en petit débit, c'est fluide... et ça économise tes données.",
   "s": 16.251,
   "e": 20.484
  },
  {
   "text": "Téléphone, tablette ou télé.",
   "s": 20.614,
   "e": 22.19
  },
  {
   "text": "Et tu testes gratuitement pendant vingt-quatre heures !",
   "s": 22.804,
   "e": 24.89
  },
  {
   "text": "Ensuite ? Mille francs CFA par mois... ou dix mille par an : deux mois offerts !",
   "s": 25.03,
   "e": 29.222
  },
  {
   "text": "Télécharge MISSA TV 360 maintenant. Ton écran mérite mieux !",
   "s": 29.496,
   "e": 33.362
  }
 ],
